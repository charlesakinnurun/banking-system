# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit a real .env or real secrets.
# .env is git-ignored; this example file is the only tracked env artifact.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Trust X-Forwarded-* only behind a proxy you control (comma-separated CIDRs or "true").
TRUST_PROXY=false

# Database (required)
DATABASE_URL=postgres://banking:banking@localhost:5432/banking
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Auth / secrets (required, >= 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=codealpha-banking
JWT_AUDIENCE=codealpha-banking-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Password hashing (scrypt). Tune cost DOWN only in tests via env.
SCRYPT_COST_N=16384
SCRYPT_BLOCK_SIZE_R=8
SCRYPT_PARALLELIZATION_P=1
SCRYPT_KEYLEN=64
SCRYPT_MAXMEM_BYTES=67108864

# Brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Rate limiting (global default; stricter per-route overrides in code)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Idempotency
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=60

# Risk / fraud thresholds (minor units unless stated)
RISK_MAX_SINGLE_TRANSFER_MINOR=100000000
RISK_DAILY_VELOCITY_MINOR=500000000
RISK_MAX_TXN_PER_MINUTE=20

# CORS: comma-separated origins. Empty disables cross-origin browser access.
CORS_ORIGINS=

# Observability
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Optional error tracking webhook (Sentry-compatible DSN is NOT parsed here; this is a hook URL).
ERROR_TRACKING_WEBHOOK_URL=

# Seed/bootstrap admin (used only by `npm run seed`). Change immediately in real deployments.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Password-123!
SEED_DEMO_DATA=true

# Integration tests: when unset, tests boot an embedded PostgreSQL automatically.
# TEST_DATABASE_URL=postgres://banking:banking@localhost:5432/banking_test
